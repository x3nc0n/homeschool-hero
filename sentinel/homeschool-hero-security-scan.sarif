          "level": "note",
          "message": {
            "text": "validate_password_policy() does not require special characters; passwords like 'Password123456789' satisfy the policy."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/validation.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 52,
                  "endLine": 60,
                  "startColumn": 1,
                  "endColumn": 55,
                  "snippet": {
                    "text": "def validate_password_policy(password: str) -> str:\n    if len(password) < settings.password_min_length:\n        raise ValueError(f'Password must be at least {settings.password_min_length} characters long')\n    validate_bcrypt_password_length(password)\n    if not any(character.isalpha() for character in password):\n        raise ValueError('Password must include at least one letter')\n    if not any(character.isdigit() for character in password):\n        raise ValueError('Password must include at least one number')\n    return password"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "category": "auth"
          },
          "fixes": [
            {
              "description": {
                "text": "Add a requirement for at least one special character: `if not any(not c.isalnum() for c in password): raise ValueError('Password must include at least one special character')`. Alternatively, consider using zxcvbn for entropy-based strength evaluation rather than composition rules."
              }
            }
          ],
          "taxa": [
