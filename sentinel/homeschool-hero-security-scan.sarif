          "ruleIndex": 58,
          "level": "warning",
          "message": {
            "text": "invitations.py lines 161-297: accept_invitation creates new users with payload.password but the InvitationAccept schema in schemas/invitations.py does not call validate_password_policy(). A new user can accept an invitation and set a password of '1' (1 character) bypassing the 12-character policy enforced at registration."
          },
          "locations": [
