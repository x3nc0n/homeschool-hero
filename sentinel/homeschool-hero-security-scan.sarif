        {
          "ruleId": "SAST-NGINX-002",
          "ruleIndex": 16,
          "level": "warning",
          "message": {
            "text": "nginx/nginx.conf location / block proxies directly to the backend with no security headers (no X-Frame-Options, X-Content-Type-Options, CSP, or HSTS)."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "nginx/nginx.conf",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "endLine": 26,
                  "startColumn": 1,
                  "endColumn": 1,
                  "snippet": {
                    "text": "    location / {\n        proxy_pass http://homeschool_app;\n        proxy_http_version 1.1;\n        proxy_set_header Host $host;\n        proxy_set_header X-Real-IP $remote_addr;\n        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;\n        proxy_set_header X-Forwarded-Host $host;\n        proxy_set_header X-Forwarded-Proto $scheme;\n        proxy_set_header X-Forwarded-Port $server_port;\n    }"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "headers"
          },
          "fixes": [
            {
              "description": {
                "text": "If this configuration is intended only for HTTP\u2192HTTPS redirect (like the TLS config's port-80 block), remove the proxy_pass and replace with `return 301 https://$host$request_uri;`. If it must proxy directly, add the same security headers as recommended for nginx-tls.conf."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-693",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
