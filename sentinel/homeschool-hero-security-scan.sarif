        {
          "ruleId": "SAST-CICD-004",
          "ruleIndex": 32,
          "level": "warning",
          "message": {
            "text": "In squad-auto-patch.yml, issue.title is embedded into PR commit messages and body via Python string .replace() with no sanitization, potentially enabling Markdown/HTML injection in the auto-generated PR."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/squad-auto-patch.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 198,
                  "endLine": 203,
                  "startColumn": 11,
                  "endColumn": 60,
                  "snippet": {
                    "text": "          body = (\n              template\n              .replace('{{ISSUE_NUMBER}}', str(payload['issue']['number']))\n              .replace('{{ISSUE_TITLE}}', payload['issue']['title'])\n              .replace('{{PACKAGE_NAME}}', payload['patch_plan']['package_name'])\n              .replace('{{FIXED_VERSION}}', payload['patch_plan']['fixed_version'])"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "cicd"
          },
          "fixes": [
            {
              "description": {
                "text": "Sanitize or truncate issue title before embedding it in output. At minimum, strip Markdown special characters and limit length:\n  import re\n  safe_title = re.sub(r'[\\[\\]()#`*_~<>!|]', '', payload['issue']['title'])[:100]\n  body = template.replace('{{ISSUE_TITLE}}', safe_title)\nAlso consider not embedding issue body in any workflow output \u2014 use only the issue number and a link to it."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-116",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "SAST-FRONTEND-001",
          "ruleIndex": 33,
          "level": "note",
          "message": {
