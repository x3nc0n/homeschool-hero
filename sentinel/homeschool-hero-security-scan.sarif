          "ruleIndex": 20,
          "level": "warning",
          "message": {
            "text": "No limit_req_zone or limit_req directives are present in nginx.conf or nginx-tls.conf. The /api/auth/* endpoints are exposed without rate limiting."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "nginx/nginx-tls.conf",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 39,
                  "endLine": 48,
                  "startColumn": 1,
                  "endColumn": 5,
                  "snippet": {
                    "text": "    location / {\n        proxy_pass http://homeschool_app;\n        proxy_http_version 1.1;\n        ...\n    }"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "nginx-misconfig"
          },
          "fixes": [
            {
              "description": {
                "text": "Define a shared memory zone and apply rate limits, especially to authentication paths:\n  http {\n    limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;\n    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=60r/m;\n  }\n  location /api/auth/ { limit_req zone=auth_limit burst=10 nodelay; ... }\n  location /api/       { limit_req zone=api_limit burst=50; ... }"
              }
            }
          ],
          "taxa": [
