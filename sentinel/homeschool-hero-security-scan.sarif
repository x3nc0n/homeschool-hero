          "ruleId": "SAST-DOCKER-003",
          "ruleIndex": 25,
          "level": "error",
          "message": {
            "text": "nginx service in docker-compose.tls.yml is missing 'security_opt: no-new-privileges:true' and 'cap_drop: ALL' that are applied to all other services via the *service_defaults anchor."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docker-compose.tls.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 28,
                  "startColumn": 3,
                  "endColumn": 1,
                  "snippet": {
                    "text": "  nginx:\n    image: nginx:1.27-alpine\n    restart: unless-stopped\n    depends_on:\n      app:\n        condition: service_healthy\n    ports:\n      - \"80:80\"\n      - \"443:443\""
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "category": "docker-security"
          },
          "fixes": [
            {
              "description": {
                "text": "Apply the service_defaults anchor to the nginx service and add the minimum required capabilities:\n  nginx:\n    <<: *service_defaults\n    cap_add:\n      - CHOWN\n      - DAC_OVERRIDE\n      - SETGID\n      - SETUID\n      - NET_BIND_SERVICE\nAlso add a healthcheck:\n  healthcheck:\n    test: [\"CMD-SHELL\", \"nginx -t || exit 1\"]\n    interval: 15s\n    timeout: 5s\n    retries: 3"
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-250",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
