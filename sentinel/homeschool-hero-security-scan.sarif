          "properties": {
            "severity": "low",
            "category": "info-disclosure"
          },
          "fixes": [
            {
              "description": {
                "text": "Replace the default bootstrap email with a placeholder that requires explicit customization (e.g., 'CHANGE_ME@example.com') and add a startup validation check that prevents bootstrapping with the placeholder value."
