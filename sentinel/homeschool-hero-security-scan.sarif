                  "endLine": 118,
                  "startColumn": 1,
                  "endColumn": 80,
                  "snippet": {
                    "text": "backup_encryption_key: str | None = Field(default=None, alias='BACKUP_ENCRYPTION_KEY')"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "info-disclosure"
          },
          "fixes": [
            {
              "description": {
                "text": "Add a startup warning when BACKUP_SCHEDULER_ENABLED=true and BACKUP_ENCRYPTION_KEY is not set. Document that backup encryption is strongly recommended for any deployment. Consider making BACKUP_ENCRYPTION_KEY required when backup destination is a non-local path (SMB, NFS)."
              }
            }
          ],
          "taxa": [
