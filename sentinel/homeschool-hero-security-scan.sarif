          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "uploads/ is served as public unauthenticated static files via app.mount('/uploads', StaticFiles(...)). Student submission files are directly accessible without authentication."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/main.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 343,
                  "endLine": 343,
                  "startColumn": 5,
                  "endColumn": 80,
                  "snippet": {
                    "text": "app.mount('/uploads', StaticFiles(directory=settings.upload_dir, check_dir=False), name='uploads')"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "critical",
            "category": "auth"
          },
          "fixes": [
            {
              "description": {
                "text": "Remove the static /uploads mount. Implement an authenticated file-serving endpoint that validates the requesting user's family_id and capabilities before streaming the file. Use send_file or FileResponse only after verifying the requesting session owns the resource."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-284",
