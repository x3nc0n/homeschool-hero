          "ruleIndex": 49,
          "level": "warning",
          "message": {
            "text": "config.py line 118: backup_encryption_key defaults to None. If the backup scheduler runs without this key set, backup files (containing passwords hashes, student work, grades, medical/educational records) are unencrypted at rest. .env.example line 114 shows the key commented out."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
