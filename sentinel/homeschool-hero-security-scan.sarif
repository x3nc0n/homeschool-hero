                  "snippet": {
                    "text": "@router.post('/{invitation_id}/accept', response_model=SessionResponse)\nasync def accept_invitation(\n    invitation_id: int,\n    payload: InvitationAccept,\n    ...\n) -> SessionResponse:\n    ...\n    user = User(\n        ...\n        password_hash=hash_password(payload.password),\n    )"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "password"
          },
          "fixes": [
