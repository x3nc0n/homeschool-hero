                  "endLine": 29,
                  "startColumn": 1,
                  "endColumn": 42,
                  "snippet": {
                    "text": "ssl_protocols TLSv1.2 TLSv1.3;\nssl_ciphers HIGH:!aNULL:!MD5;"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "tls"
          },
          "fixes": [
            {
              "description": {
                "text": "Replace with the Mozilla SSL Configuration Generator's Intermediate profile: ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384; ssl_prefer_server_ciphers off;"
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-326",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
