                  "endColumn": 80,
                  "snippet": {
                    "text": "add_header Strict-Transport-Security \"max-age=31536000; includeSubDomains\" always;"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "category": "headers"
          },
          "fixes": [
            {
              "description": {
                "text": "Add all of the following headers inside the server { listen 443 \u2026 } block:\n  add_header X-Frame-Options \"SAMEORIGIN\" always;\n  add_header X-Content-Type-Options \"nosniff\" always;\n  add_header Referrer-Policy \"strict-origin-when-cross-origin\" always;\n  add_header Permissions-Policy \"geolocation=(), camera=(), microphone=()\" always;\n  add_header Content-Security-Policy \"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';\" always;"
              }
            }
          ],
