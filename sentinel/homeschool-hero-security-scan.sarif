              "description": {
                "text": "Add a field_validator for the password field in InvitationAccept schema that calls validate_password_policy(). Alternatively, share the validator with RegisterRequest. Also check the schemas/invitations.py InvitationAccept model for min_length constraints on the password field."
              }
            }
          ],
          "taxa": [
