          "ruleIndex": 28,
          "level": "note",
          "message": {
            "text": "PostgreSQL db service adds DAC_OVERRIDE and FOWNER capabilities, which grant broad filesystem access override beyond what's needed for normal database operation after initial setup."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docker-compose.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 60,
                  "endLine": 66,
                  "startColumn": 5,
                  "endColumn": 16,
                  "snippet": {
                    "text": "    cap_add:\n      - CHOWN\n      - DAC_OVERRIDE\n      - FOWNER\n      - SETGID\n      - SETUID"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "category": "docker-security"
          },
          "fixes": [
            {
              "description": {
                "text": "Investigate whether all five capabilities are truly required for PostgreSQL 16-alpine. Typically only CHOWN, SETGID, and SETUID are needed for the init scripts. DAC_OVERRIDE and FOWNER can often be removed once data directory ownership is correctly initialized. Test removal in a dev environment and confirm pg_isready passes on startup."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-250",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
