        {
          "ruleId": "SAST-PYTHON-005",
          "ruleIndex": 4,
          "level": "error",
          "message": {
            "text": "get_request_ip() returns forwarded_for.split(',')[0].strip() without validating the header, allowing rate limit bypass via forged X-Forwarded-For."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/security.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 244,
                  "endLine": 249,
                  "startColumn": 5,
                  "endColumn": 50,
                  "snippet": {
                    "text": "def get_request_ip(request: Request) -> str:\n    forwarded_for = request.headers.get('x-forwarded-for', '')\n    if forwarded_for:\n        return forwarded_for.split(',')[0].strip()\n    client = request.client\n    return client.host if client else 'unknown'"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "category": "auth"
          },
          "fixes": [
            {
              "description": {
                "text": "Only trust X-Forwarded-For when the connection comes from a known trusted proxy (check request.client.host against a configured trusted proxy list). For deployments behind a single load balancer, take the last untrusted IP from the chain rather than the first. Consider using a middleware like uvicorn's ProxyHeadersMiddleware with explicit trusted_ips configuration."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-348",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "SAST-PYTHON-006",
          "ruleIndex": 5,
          "level": "warning",
          "message": {
            "text": "CSRF tokens compared with != (string equality) instead of hmac.compare_digest(), enabling a timing side-channel attack."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/security.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
