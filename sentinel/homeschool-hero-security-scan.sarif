          "ruleId": "SAST-CICD-003",
          "ruleIndex": 31,
          "level": "warning",
          "message": {
            "text": "release.yml grants contents: write and packages: write at the workflow level, allowing any compromised step to overwrite releases or push malicious container images."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".github/workflows/release.yml",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 11,
                  "endLine": 13,
                  "startColumn": 1,
                  "endColumn": 20,
                  "snippet": {
                    "text": "permissions:\n  contents: write\n  packages: write"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "cicd"
          },
          "fixes": [
            {
              "description": {
                "text": "Move permissions to the job level and use the minimum needed:\n  jobs:\n    release:\n      permissions:\n        contents: write   # for softprops/action-gh-release\n        packages: write   # for docker/build-push-action\nAt the workflow level, set the default to read-only:\n  permissions: read-all\nThis limits blast radius if one step is compromised."
              }
            }
          ],
          "taxa": [
