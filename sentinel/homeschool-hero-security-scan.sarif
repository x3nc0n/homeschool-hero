          ],
          "properties": {
            "severity": "medium",
            "category": "nginx-misconfig"
          },
          "fixes": [
            {
              "description": {
                "text": "If Nginx is the first (and only) public-facing proxy, replace with `proxy_set_header X-Forwarded-For $remote_addr;` to strip any client-supplied values. If there are trusted upstream proxies, configure `set_real_ip_from` and `real_ip_header` to correctly resolve the real client IP, then pass only the resolved value."
