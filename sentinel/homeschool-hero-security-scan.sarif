                  "startLine": 35,
                  "endLine": 35,
                  "startColumn": 24,
                  "endColumn": 58,
                  "snippet": {
                    "text": "  const providerError = useMemo(() => searchParams.get('error')?.trim() || '', [searchParams])"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "category": "xss"
          },
          "fixes": [
            {
              "description": {
                "text": "Validate the error parameter against an allowlist of known provider error codes rather than reflecting arbitrary text:\n  const KNOWN_ERRORS = new Set(['access_denied', 'server_error', 'temporarily_unavailable']);\n  const providerError = useMemo(() => {\n    const raw = searchParams.get('error')?.trim() || '';\n    return KNOWN_ERRORS.has(raw) ? raw : (raw ? 'unknown_error' : '');\n  }, [searchParams]);\nThen use a translation key for the display message rather than showing the raw error value."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-79",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "SAST-FRONTEND-002",
          "ruleIndex": 34,
          "level": "warning",
          "message": {
            "text": "Workbox runtimeCaching caches all GET /api/* responses for up to 86400 seconds (24 hours). After logout, the cache is not cleared, potentially exposing family/student data to subsequent device users."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/vite.config.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 54,
                  "endLine": 67,
                  "startColumn": 11,
                  "endColumn": 13,
                  "snippet": {
                    "text": "            urlPattern: ({ request, url }) => request.method === 'GET' && url.pathname.startsWith('/api/'),\n            handler: 'NetworkFirst',\n            options: {\n              cacheName: 'api-cache',\n              networkTimeoutSeconds: 5,\n              cacheableResponse: {\n                statuses: [0, 200],\n              },\n              expiration: {\n                maxEntries: 60,\n                maxAgeSeconds: 24 * 60 * 60,\n              },\n            },"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "data-exposure"
          },
          "fixes": [
            {
              "description": {
                "text": "Clear the API cache on logout. In the service worker or via a Workbox background sync message, call `caches.delete('api-cache')` when the AUTH_EXPIRED_EVENT fires. Additionally, consider restricting which API paths are cached to only non-sensitive read endpoints (e.g., static lookup data), and exclude endpoints that return PII such as /api/students, /api/grades, /api/attendance."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-524",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "SAST-FRONTEND-003",
          "ruleIndex": 35,
          "level": "note",
          "message": {
            "text": "PWA workbox options skipWaiting: true and clientsClaim: true allow a new service worker to immediately take over all clients, potentially disrupting active authenticated sessions."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "frontend/vite.config.ts",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 18,
                  "endLine": 20,
                  "startColumn": 9,
                  "endColumn": 26,
                  "snippet": {
                    "text": "        cleanupOutdatedCaches: true,\n        clientsClaim: true,\n        skipWaiting: true,"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "category": "data-exposure"
          },
          "fixes": [
            {
              "description": {
                "text": "If immediate updates are required for security patches, retain skipWaiting but add a service worker message listener to notify the app of the update and trigger a controlled reload:\n  // In the app:\n  if (navigator.serviceWorker.controller) {\n    navigator.serviceWorker.addEventListener('controllerchange', () => window.location.reload());\n  }\nThis ensures active sessions complete their current operation before the new service worker takes over."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-613",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
