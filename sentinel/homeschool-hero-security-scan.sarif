                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "cookie"
          },
          "fixes": [
            {
              "description": {
                "text": "Default SESSION_COOKIE_SECURE to True in production. Add a startup validation warning if SESSION_COOKIE_SECURE=false and TLS_ENABLED=true. In is_secure_request(), consider only trusting X-Forwarded-Proto when a TRUSTED_PROXY_CIDR whitelist is configured."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-614",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "DAST-CONFIG-004",
          "ruleIndex": 40,
          "level": "warning",
          "message": {
            "text": "RateLimiter stores all request timestamps in memory (self._requests: dict). On restart, all buckets are cleared, resetting rate-limit state for auth and upload endpoints. In a Docker Swarm or Kubernetes deployment with rolling updates, a new replica starts with an empty limiter, enabling brute-force attacks against /api/auth/login to continue unimpeded after a brief wait."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/rate_limit.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 16,
                  "endLine": 18,
                  "startColumn": 1,
                  "endColumn": 60,
                  "snippet": {
                    "text": "class RateLimiter:\n    def __init__(self) -> None:\n        self._requests: dict[tuple[str, str], deque[float]] = defaultdict(deque)"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "rate-limiting"
          },
          "fixes": [
            {
              "description": {
                "text": "Replace the in-memory limiter with a Redis-backed solution (e.g., slowapi with Redis storage, or a custom implementation using aioredis) so rate-limit state persists across restarts and is shared across replicas. For a single-instance home-server deployment this is lower priority, but document the limitation clearly."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-770",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "DAST-CONFIG-005",
          "ruleIndex": 41,
          "level": "warning",
          "message": {
            "text": "security.py line 245 splits X-Forwarded-For on comma and returns the first element. nginx.conf uses proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for which appends but does not strip. A client sending 'X-Forwarded-For: 192.168.1.1' will have rate limits applied against '192.168.1.1' rather than their real IP, bypassing auth rate limiting."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/security.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 244,
                  "endLine": 249,
                  "startColumn": 1,
                  "endColumn": 55,
                  "snippet": {
                    "text": "def get_request_ip(request: Request) -> str:\n    forwarded_for = request.headers.get('x-forwarded-for', '')\n    if forwarded_for:\n        return forwarded_for.split(',')[0].strip()"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "medium",
            "category": "rate-limiting"
          },
          "fixes": [
            {
              "description": {
                "text": "Take the LAST non-trusted IP in X-Forwarded-For (the one appended by your own nginx), or configure nginx with 'real_ip_header X-Forwarded-For; set_real_ip_from <nginx_cidr>;' and use $remote_addr. Alternatively, strip the X-Forwarded-For header in nginx before re-adding it: 'proxy_set_header X-Forwarded-For $remote_addr;'."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-290",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "DAST-CONFIG-006",
          "ruleIndex": 42,
          "level": "warning",
          "message": {
            "text": "nginx/nginx-tls.conf line 29: ssl_ciphers HIGH:!aNULL:!MD5 includes 3DES and other legacy ciphers. This cipher string accepts ECDHE-RSA-DES-CBC3-SHA which is vulnerable to SWEET32 (CVE-2016-2183). The nginx-tls.conf also includes TLSv1.2 without forward secrecy enforcement."
          },
          "locations": [
