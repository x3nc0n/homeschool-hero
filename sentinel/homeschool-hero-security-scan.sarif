        {
          "ruleId": "DAST-CONFIG-001",
          "ruleIndex": 37,
          "level": "error",
          "message": {
            "text": "app.mount('/uploads', StaticFiles(...)) is registered outside the /api prefix. The security_middleware only protects _is_api_path() routes, leaving /uploads fully unauthenticated. Anyone who obtains a file path URL (from DOM inspection, shared links, or XSS) can download sensitive student work without logging in."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/main.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 343,
                  "endLine": 343,
                  "startColumn": 1,
                  "endColumn": 80,
                  "snippet": {
                    "text": "app.mount('/uploads', StaticFiles(directory=settings.upload_dir, check_dir=False), name='uploads')"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "category": "access-control"
          },
          "fixes": [
            {
              "description": {
                "text": "Serve upload files through an authenticated API endpoint (e.g., GET /api/files/{path:path}) that verifies the requesting user's family_id matches the resource owner before streaming the file. Alternatively, generate signed, short-lived download URLs and validate them server-side."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-284",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "DAST-CONFIG-002",
          "ruleIndex": 38,
          "level": "error",
          "message": {
            "text": "config.py lines 19 and 68 set default values of 'dev-secret-change-me' and 'changeme' for SECRET_KEY and FAMILY_PASSWORD. .env.example line 5 ships POSTGRES_PASSWORD=changeme and line 55 ships FAMILY_PASSWORD=changeme. Operators who deploy without customizing these values expose the database and session signing to trivial compromise."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/config.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 15,
                  "endLine": 19,
                  "startColumn": 1,
                  "endColumn": 70,
                  "snippet": {
                    "text": "postgres_password: str = Field('changeme', alias='POSTGRES_PASSWORD')\n...\nsecret_key: str = Field('dev-secret-change-me', alias='SECRET_KEY')"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "high",
            "category": "session"
          },
          "fixes": [
            {
              "description": {
                "text": "Remove all default secret values from config.py and .env.example. Require explicit values at startup for SECRET_KEY, POSTGRES_PASSWORD, and FAMILY_PASSWORD (even if legacy). Add a startup validation check for POSTGRES_PASSWORD similar to the existing SECRET_KEY check in _validate_secret_key()."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-798",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
