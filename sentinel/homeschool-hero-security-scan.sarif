{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SecOps Squad Security Scanner",
          "version": "1.0.0",
          "semanticVersion": "1.0.0",
          "informationUri": "https://github.com/secops-squad",
          "organization": "SecOps Squad",
          "fullName": "SecOps Squad SAST+DAST Security Scanner v1.0.0",
          "shortDescription": {
            "text": "Comprehensive SAST and DAST security scanner powered by SecOps Squad AI agents"
          },
          "fullDescription": {
            "text": "A multi-agent security scanning tool that performs Static Application Security Testing (SAST) and Dynamic Application Security Testing (DAST) analysis. Agents: Kima (Python backend SAST), Sydnor (Frontend/Docker/Nginx/CI SAST), McNulty (DAST-style config and architecture analysis)."
          },
          "rules": [
            {
              "id": "SAST-PYTHON-001",
              "name": "Unauthenticated Static Upload Serving",
              "shortDescription": {
                "text": "Unauthenticated Static Upload Serving"
              },
              "fullDescription": {
                "text": "The /uploads directory is mounted as an unauthenticated StaticFiles endpoint. Any file stored under the upload directory \u2014 including student homework submissions, OCR-processed documents, and portfolio attachments \u2014 is accessible to any unauthenticated party who knows or guesses the file path. File paths follow a predictable pattern: /uploads/<family_id>/<student_id>/<assignment_id>/<submission_id>/<filename>."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "auth"
                ],
                "security-severity": "9.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-284",
                    "guid": "08434d12-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/284.html"
            },
            {
              "id": "SAST-PYTHON-002",
              "name": "Hardcoded Default Credentials in Config",
              "shortDescription": {
                "text": "Hardcoded Default Credentials in Config"
              },
              "fullDescription": {
                "text": "Default values for POSTGRES_PASSWORD and FAMILY_PASSWORD are set to 'changeme' in code. Unlike SECRET_KEY (which has an explicit startup validator that rejects placeholder values), these two fields have no such enforcement. If an operator deploys without setting these environment variables, the application starts with known default credentials."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-798",
                    "guid": "06db8e86-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html"
            },
            {
              "id": "SAST-PYTHON-003",
              "name": "Hardcoded Database Credentials in alembic.ini",
              "shortDescription": {
                "text": "Hardcoded Database Credentials in alembic.ini"
              },
              "fullDescription": {
                "text": "alembic.ini contains a hardcoded database URL with username and password committed directly into the repository. Even if the value is a known placeholder ('changeme'), the pattern normalises credential leakage and will appear in git history and any repository forks."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-312",
                    "guid": "0296d975-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/312.html"
            },
            {
              "id": "SAST-PYTHON-004",
              "name": "Hardcoded Weak Demo Password in Source",
              "shortDescription": {
                "text": "Hardcoded Weak Demo Password in Source"
              },
              "fullDescription": {
                "text": "A plaintext weak password ('demo1234') is hardcoded as a module-level constant in seed_demo.py and used to create demo user accounts. This password is publicly known by anyone reading the source code, does not meet the application's own password policy (requires a letter and digit plus 12-char minimum \u2014 'demo1234' is only 8 chars and would fail validate_password_policy), and hash_password() is called at seed time bypassing the policy check."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "secrets"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-521",
                    "guid": "6a92f43b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/521.html"
            },
            {
              "id": "SAST-PYTHON-005",
              "name": "X-Forwarded-For Header Trusted Without Validation",
              "shortDescription": {
                "text": "X-Forwarded-For Header Trusted Without Validation"
              },
              "fullDescription": {
                "text": "get_request_ip() unconditionally trusts the first value of the X-Forwarded-For header to determine the client IP address. This IP is used as the key for IP-based rate limiting on authentication endpoints (5 requests/60s per IP). An attacker can include a forged X-Forwarded-For header (e.g., 'X-Forwarded-For: 1.2.3.4') to impersonate an arbitrary IP address, effectively bypassing auth rate limiting with unlimited login attempts."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "auth"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-348",
                    "guid": "bdb61225-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/348.html"
            },
            {
              "id": "SAST-PYTHON-006",
              "name": "CSRF Token Compared with String Equality (Timing Attack)",
              "shortDescription": {
                "text": "CSRF Token Compared with String Equality (Timing Attack)"
              },
              "fullDescription": {
                "text": "CSRF token validation in require_csrf() uses Python's standard string equality operator (!=) to compare the cookie token, header token, and the session-stored CSRF claim. Standard string comparison short-circuits on the first differing character, creating a timing side-channel. An attacker with the ability to make many requests and measure response times could use this to infer valid CSRF token characters."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "auth"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-208",
                    "guid": "874cdee9-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/208.html"
            },
            {
              "id": "SAST-PYTHON-007",
              "name": "In-Memory Rate Limiter Not Distributed",
              "shortDescription": {
                "text": "In-Memory Rate Limiter Not Distributed"
              },
              "fullDescription": {
                "text": "The RateLimiter class in rate_limit.py stores all request tracking in a per-process in-memory dict. In containerised deployments with multiple worker processes (uvicorn with --workers N) or horizontal scaling with multiple replicas, each instance maintains its own independent counter. The effective rate limit becomes N \u00d7 configured_limit, where N is the number of processes. The auth rate limit of 5 req/60s per IP becomes effectively unlimited in scaled deployments."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "rate-limiting"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-307",
                    "guid": "a496f457-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/307.html"
            },
            {
              "id": "SAST-PYTHON-008",
              "name": "Backup Data Stored Unencrypted by Default",
              "shortDescription": {
                "text": "Backup Data Stored Unencrypted by Default"
              },
              "fullDescription": {
                "text": "BACKUP_ENCRYPTION_KEY is an optional setting that defaults to None. When unset, the restic backup process runs with RESTIC_PASSWORD='' (empty string), and plain-copy backups have no encryption layer at all. Database dumps, OCR-processed student work, and full data exports are stored unencrypted at the backup destination. This is a significant data-at-rest exposure for a system handling student records."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "crypto"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-311",
                    "guid": "e1564903-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/311.html"
            },
            {
              "id": "SAST-PYTHON-009",
              "name": "Portfolio File Upload Missing Explicit Path Traversal Guard",
              "shortDescription": {
                "text": "Portfolio File Upload Missing Explicit Path Traversal Guard"
              },
              "fullDescription": {
                "text": "The portfolio attachment upload in _store_portfolio_attachment() constructs the destination path as Path(settings.upload_dir) / relative_path without calling the hardened _resolve_safe_upload_destination() helper that submission uploads use. While the relative_path is constructed from integer IDs (reducing injection risk), sanitize_filename() only sanitises the filename component \u2014 there is no realpath-based containment check verifying the final destination is within upload_dir."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "path-traversal"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-22",
                    "guid": "98103e30-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/22.html"
            },
            {
              "id": "SAST-PYTHON-010",
              "name": "SMTP TLS Disabled in Default Configuration Template",
              "shortDescription": {
                "text": "SMTP TLS Disabled in Default Configuration Template"
              },
              "fullDescription": {
                "text": "The .env.example file ships with SMTP_USE_TLS=false as a default for local development. Operators who copy this file as-is and configure real SMTP credentials will transmit email content and SMTP login credentials in cleartext. The email service contains user-facing security alerts (account lockout notifications) and invitation tokens, making cleartext exposure especially sensitive."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "crypto"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-319",
                    "guid": "501ea8cc-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/319.html"
            },
            {
              "id": "SAST-PYTHON-011",
              "name": "subprocess stderr Exposed via RuntimeError (Internal Info Disclosure)",
              "shortDescription": {
                "text": "subprocess stderr Exposed via RuntimeError (Internal Info Disclosure)"
              },
              "fullDescription": {
                "text": "pg_dump and pg_restore subprocess error output (stderr) is passed directly into RuntimeError messages in backup_service.py and restore_service.py. While the generic exception handler in main.py returns a sanitised 'unexpected error' response, the raw RuntimeError \u2014 which may include database error messages, internal paths, or PostgreSQL version strings \u2014 is logged at ERROR level and accessible in log aggregation systems."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-209",
                    "guid": "5ff2ed62-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/209.html"
            },
            {
              "id": "SAST-PYTHON-012",
              "name": "Password Policy Missing Special Character Requirement",
              "shortDescription": {
                "text": "Password Policy Missing Special Character Requirement"
              },
              "fullDescription": {
                "text": "validate_password_policy() enforces minimum length (12 chars from config), at least one letter, and at least one digit \u2014 but does not require any special characters. This limits resistance against dictionary attacks and credential stuffing on accounts using common password patterns like 'Password123456' which pass the policy."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "auth"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-521",
                    "guid": "6a92f43b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/521.html"
            },
            {
              "id": "SAST-PYTHON-013",
              "name": "SAML AuthnRequests Not Signed",
              "shortDescription": {
                "text": "SAML AuthnRequests Not Signed"
              },
              "fullDescription": {
                "text": "The SAML SP settings configure authnRequestsSigned=False. Unsigned AuthnRequests allow an attacker to craft and send arbitrary authentication requests to the IdP. While the IdP assertion signature (wantAssertionsSigned=True) still validates the IdP response, unsigned requests reduce non-repudiation and may allow IdP-bypass attacks in certain SAML configurations."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "auth"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-347",
                    "guid": "6e99ca2e-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/347.html"
            },
            {
              "id": "SAST-PYTHON-014",
              "name": "JWT Symmetric Key Accepted Without Minimum Length Enforcement",
              "shortDescription": {
                "text": "JWT Symmetric Key Accepted Without Minimum Length Enforcement"
              },
              "fullDescription": {
                "text": "When JWT_SECRET is configured, _resolve_signing_key() returns it directly as the signing key for token verification. Any non-empty string is accepted \u2014 including short or weak secrets. A 4-character JWT_SECRET is as accepted as a 256-bit one. This is particularly relevant since the default JWT_ALGORITHM is RS256 (asymmetric) but the code accepts HS* algorithms via configuration, and operators who set JWT_SECRET and JWT_ALGORITHM=HS256 may use weak secrets."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "crypto"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-326",
                    "guid": "9b173b55-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/326.html"
            },
            {
              "id": "SAST-PYTHON-015",
              "name": "Restic Backup Password Passed via Full Environment Inheritance",
              "shortDescription": {
                "text": "Restic Backup Password Passed via Full Environment Inheritance"
              },
              "fullDescription": {
                "text": "subprocess.run() for restic and pg_dump commands inherits the full process environment ({**os.environ, **env}). This means the RESTIC_PASSWORD and PGPASSWORD environment variables are passed via the full env dict which includes all parent process environment variables. While this is a standard pattern for passing secrets to subprocesses, any other subprocess-spawned process could inherit these variables if not explicitly cleared."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "secrets"
                ],
                "security-severity": "1.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-214",
                    "guid": "4b0d06e4-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/214.html"
            },
            {
              "id": "SAST-NGINX-001",
              "name": "Missing Critical Security Headers",
              "shortDescription": {
                "text": "Missing Critical Security Headers"
              },
              "fullDescription": {
                "text": "The production TLS Nginx configuration lacks multiple OWASP-recommended security response headers that protect against clickjacking, MIME-sniffing, and cross-site scripting. The absence of Content-Security-Policy is particularly high-severity for a React SPA."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "headers"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-693",
                    "guid": "2a0bb123-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/693.html"
            },
            {
              "id": "SAST-NGINX-002",
              "name": "Missing Security Headers in Non-TLS Config",
              "shortDescription": {
                "text": "Missing Security Headers in Non-TLS Config"
              },
              "fullDescription": {
                "text": "The plain-HTTP (non-TLS) Nginx configuration has no security response headers at all. While HTTP-only configurations are typically used for dev or ACME challenge redirect, the location / block proxies all traffic to the backend without any hardening headers."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "headers"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-693",
                    "guid": "2a0bb123-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/693.html"
            },
            {
              "id": "SAST-NGINX-003",
              "name": "server_tokens Not Disabled",
              "shortDescription": {
                "text": "server_tokens Not Disabled"
              },
              "fullDescription": {
                "text": "Neither Nginx configuration explicitly disables server_tokens. By default, Nginx includes its version number in error pages and the Server response header, aiding an attacker in fingerprinting the server for targeted CVE exploitation."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx-misconfig"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-200",
                    "guid": "88a4db48-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html"
            },
            {
              "id": "SAST-NGINX-004",
              "name": "Broad SSL Cipher Specification",
              "shortDescription": {
                "text": "Broad SSL Cipher Specification"
              },
              "fullDescription": {
                "text": "The TLS configuration uses the broad cipher string `HIGH:!aNULL:!MD5`, which includes legacy cipher suites such as TLS_RSA_* (no perfect forward secrecy), CBC-mode ciphers, and potentially weaker key exchange algorithms. It also lacks `ssl_prefer_server_ciphers on` for TLS 1.2."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "tls"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-326",
                    "guid": "9b173b55-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/326.html"
            },
            {
              "id": "SAST-NGINX-005",
              "name": "HSTS Missing preload Directive",
              "shortDescription": {
                "text": "HSTS Missing preload Directive"
              },
              "fullDescription": {
                "text": "The HSTS header in nginx-tls.conf uses max-age=31536000 with includeSubDomains but omits the `preload` directive. Without preload, browsers do not add the domain to their HSTS preload lists, leaving first-visit and cleared-cache scenarios unprotected."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "tls"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-319",
                    "guid": "501ea8cc-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/319.html"
            },
            {
              "id": "SAST-NGINX-006",
              "name": "Missing Rate Limiting",
              "shortDescription": {
                "text": "Missing Rate Limiting"
              },
              "fullDescription": {
                "text": "Neither Nginx configuration defines rate limiting (`limit_req_zone` / `limit_req`) on any location block. The API and authentication endpoints are therefore unprotected against brute-force credential stuffing, denial-of-service, and enumeration attacks."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx-misconfig"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-770",
                    "guid": "a3b75884-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/770.html"
            },
            {
              "id": "SAST-NGINX-007",
              "name": "Wildcard server_name Allows Host Header Injection",
              "shortDescription": {
                "text": "Wildcard server_name Allows Host Header Injection"
              },
              "fullDescription": {
                "text": "Both Nginx configurations use `server_name _;` which matches any hostname. This means the server responds to arbitrary Host headers without validation. If the backend trusts the Host or X-Forwarded-Host header (e.g. for email link generation or CSRF origin checks), an attacker can inject a crafted hostname."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx-misconfig"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-20",
                    "guid": "c7bf7667-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/20.html"
            },
            {
              "id": "SAST-NGINX-008",
              "name": "X-Forwarded-For Header Spoofable",
              "shortDescription": {
                "text": "X-Forwarded-For Header Spoofable"
              },
              "fullDescription": {
                "text": "Both Nginx configs use `proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`. This directive appends the connecting client IP to any existing X-Forwarded-For value in the incoming request. A client that sends a forged X-Forwarded-For header will have it passed through, allowing IP spoofing if the backend trusts this header for rate limiting, audit logging, or geo-restrictions."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "nginx-misconfig"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-348",
                    "guid": "bdb61225-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/348.html"
            },
            {
              "id": "SAST-DOCKER-001",
              "name": "Floating :latest Image Tag for Ollama",
              "shortDescription": {
                "text": "Floating :latest Image Tag for Ollama"
              },
              "fullDescription": {
                "text": "The ollama service uses `ollama/ollama:latest`, a floating tag that resolves to a different image digest on every pull. This prevents reproducible builds and can silently introduce vulnerabilities, breaking changes, or supply-chain attacks when the upstream image is updated."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "docker-security"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-1357",
                    "guid": "d051288b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/1357.html"
            },
            {
              "id": "SAST-DOCKER-002",
              "name": "Floating :latest Image Tag for Mailpit",
              "shortDescription": {
                "text": "Floating :latest Image Tag for Mailpit"
              },
              "fullDescription": {
                "text": "The smtp (Mailpit) service uses `axllent/mailpit:latest`. Same supply-chain risk as the Ollama finding: no reproducibility, potential for silent vulnerability introduction."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "docker-security"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-1357",
                    "guid": "d051288b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/1357.html"
            },
            {
              "id": "SAST-DOCKER-003",
              "name": "Nginx Service Missing Security Hardening Options",
              "shortDescription": {
                "text": "Nginx Service Missing Security Hardening Options"
              },
              "fullDescription": {
                "text": "The nginx service defined in docker-compose.tls.yml does not reference the `*service_defaults` YAML anchor that all other services use. As a result, the nginx container runs without `security_opt: no-new-privileges:true` and without `cap_drop: ALL`, meaning it retains all default Linux capabilities and can potentially escalate privileges."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "docker-security"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-250",
                    "guid": "bf63e4e3-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html"
            },
            {
              "id": "SAST-DOCKER-004",
              "name": "Dockerfile Missing HEALTHCHECK Instruction",
              "shortDescription": {
                "text": "Dockerfile Missing HEALTHCHECK Instruction"
              },
              "fullDescription": {
                "text": "The Dockerfile does not include a HEALTHCHECK instruction. While docker-compose.yml defines a healthcheck, Docker Swarm and standalone `docker run` deployments (without Compose) would have no health awareness, preventing orchestrators from restarting unhealthy containers."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "docker-security"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-778",
                    "guid": "14f7bca2-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/778.html"
            },
            {
              "id": "SAST-DOCKER-005",
              "name": "SMTP Web UI Bound to All Interfaces",
              "shortDescription": {
                "text": "SMTP Web UI Bound to All Interfaces"
              },
              "fullDescription": {
                "text": "The Mailpit SMTP service exposes its web UI on port 8025 with no IP binding restriction. Docker maps this to `0.0.0.0:8025` by default, making the email inspection UI accessible from any network interface on the host. On a cloud VM or shared host this could expose all application emails (including password reset tokens and invitation links) to the network."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "docker-security"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-284",
                    "guid": "08434d12-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/284.html"
            },
            {
              "id": "SAST-DOCKER-006",
              "name": "PostgreSQL Container Granted Broad Linux Capabilities",
              "shortDescription": {
                "text": "PostgreSQL Container Granted Broad Linux Capabilities"
              },
              "fullDescription": {
                "text": "The db service adds CHOWN, DAC_OVERRIDE, FOWNER, SETGID, and SETUID capabilities. DAC_OVERRIDE (bypass file permission checks) and FOWNER (bypass ownership checks for all filesystem operations) are particularly powerful capabilities. If the PostgreSQL process or a shared library is compromised, these capabilities significantly expand what an attacker can do inside the container."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "docker-security"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-250",
                    "guid": "bf63e4e3-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/250.html"
            },
            {
              "id": "SAST-CICD-001",
              "name": "Third-Party CI Actions Not Pinned to Commit SHA",
              "shortDescription": {
                "text": "Third-Party CI Actions Not Pinned to Commit SHA"
              },
              "fullDescription": {
                "text": "Multiple GitHub Actions workflows use third-party actions pinned to mutable version tags (@v2, @v3, @v7, @v2.3.9) rather than immutable commit SHAs. If a third-party action's tag is moved (intentionally or through a supply-chain attack), the workflow executes attacker-controlled code with the workflow's permissions \u2014 including contents: write and pull-requests: write."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "cicd"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-829",
                    "guid": "9ae77000-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/829.html"
            },
            {
              "id": "SAST-CICD-002",
              "name": "Hardcoded Test Database Password in CI Workflows",
              "shortDescription": {
                "text": "Hardcoded Test Database Password in CI Workflows"
              },
              "fullDescription": {
                "text": "Both ci.yml and squad-auto-patch.yml hardcode the test PostgreSQL password as 'changeme' in plaintext within the workflow YAML. While these are ephemeral CI credentials, hardcoded credentials in source code are flagged by secret scanners and can be mistakenly reused in staging or production environments."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "secrets"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-798",
                    "guid": "06db8e86-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html"
            },
            {
              "id": "SAST-CICD-003",
              "name": "Broad Permissions in Release Workflow",
              "shortDescription": {
                "text": "Broad Permissions in Release Workflow"
              },
              "fullDescription": {
                "text": "The release.yml workflow declares top-level `permissions: contents: write` and `packages: write`. These permissions apply to all jobs. The workflow runs on tag pushes and any compromise of the workflow (e.g. via a compromised action) would allow overwriting release artifacts or pushing arbitrary container images to GHCR under the repository's identity."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "cicd"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-269",
                    "guid": "a9691139-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/269.html"
            },
            {
              "id": "SAST-CICD-004",
              "name": "Auto-Patch Workflow Processes Untrusted Issue Content",
              "shortDescription": {
                "text": "Auto-Patch Workflow Processes Untrusted Issue Content"
              },
              "fullDescription": {
                "text": "squad-auto-patch.yml reads issue.title from the GitHub event payload (user-controlled) via a Python script and embeds the result into commit message, PR title, and PR body outputs. Although these are used in action `with:` parameters (not shell run: steps) and are therefore not directly shell-injectable, the issue title is inserted verbatim into the PR body template with Python str.replace(), with no escaping or sanitization. A crafted issue title could inject Markdown or HTML into the auto-generated PR body."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "cicd"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-116",
                    "guid": "f8ba1a81-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/116.html"
            },
            {
              "id": "SAST-FRONTEND-001",
              "name": "URL Query Parameter Reflected in Rendered UI",
              "shortDescription": {
                "text": "URL Query Parameter Reflected in Rendered UI"
              },
              "fullDescription": {
                "text": "LoginPage.tsx reads the `error` query parameter from the URL and renders it directly in the JSX as `{providerError}`. React's JSX text interpolation automatically HTML-encodes the value, so this is not a traditional XSS vulnerability. However, the pattern of reflecting a URL parameter in the DOM makes the page susceptible to social engineering \u2014 an attacker can craft a URL with a convincing fake error message to deceive users (e.g., phishing via a link that says 'Your session expired \u2014 please re-enter credentials')."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "xss"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-79",
                    "guid": "2482e38e-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/79.html"
            },
            {
              "id": "SAST-FRONTEND-002",
              "name": "Service Worker Caches Authenticated API Responses",
              "shortDescription": {
                "text": "Service Worker Caches Authenticated API Responses"
              },
              "fullDescription": {
                "text": "vite.config.ts configures Workbox to cache all GET /api/* responses for up to 24 hours with up to 60 entries. After a user logs out, these cached API responses (which may contain PII such as student records, grades, and attendance data) remain in the service worker cache on the device. The next request will attempt the network first, but if the device is offline or the network is unavailable, stale authenticated data can be served to whoever is using the device."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "data-exposure"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-524",
                    "guid": "6b1f4c5c-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/524.html"
            },
            {
              "id": "SAST-FRONTEND-003",
              "name": "PWA skipWaiting and clientsClaim May Expose Stale Authenticated Data",
              "shortDescription": {
                "text": "PWA skipWaiting and clientsClaim May Expose Stale Authenticated Data"
              },
              "fullDescription": {
                "text": "vite.config.ts enables both `skipWaiting: true` and `clientsClaim: true` in the Workbox service worker. This combination means a new service worker immediately takes control of all open tabs on install, without waiting for the user to close and reopen the app. If the new service worker has a modified caching policy or serves updated API cache entries, active sessions in other tabs may see unexpected behavior, and users may not realize their session state has changed."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "data-exposure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-613",
                    "guid": "238b6c47-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/613.html"
            },
            {
              "id": "SAST-FRONTEND-004",
              "name": "localStorage Used for UI Preference Data",
              "shortDescription": {
                "text": "localStorage Used for UI Preference Data"
              },
              "fullDescription": {
                "text": "The frontend uses localStorage in four locations to store: UI preferences (theme, language, layout), the user's language preference, and recent search queries. None of these contain credentials or session tokens \u2014 the authentication is fully cookie-based with CSRF protection. This is informational, not a vulnerability, but documents the data stored client-side."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "data-exposure"
                ],
                "security-severity": "1.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-312",
                    "guid": "0296d975-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/312.html"
            },
            {
              "id": "DAST-CONFIG-001",
              "name": "Unauthenticated Static File Serving for User Uploads",
              "shortDescription": {
                "text": "Unauthenticated Static File Serving for User Uploads"
              },
              "fullDescription": {
                "text": "Uploaded files (student submissions, portfolio attachments) are served via Starlette StaticFiles outside the authenticated /api prefix. The security middleware only enforces auth for paths starting with /api, so any request to /uploads/<path> bypasses authentication entirely."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "access-control"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-284",
                    "guid": "08434d12-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/284.html"
            },
            {
              "id": "DAST-CONFIG-002",
              "name": "Default Weak Credentials in Config and .env.example",
              "shortDescription": {
                "text": "Default Weak Credentials in Config and .env.example"
              },
              "fullDescription": {
                "text": "Multiple secrets default to well-known placeholder values. secret_key defaults to 'dev-secret-change-me', POSTGRES_PASSWORD to 'changeme', and FAMILY_PASSWORD to 'changeme'. While startup.py validates SECRET_KEY at boot (only when testing=False), the database and legacy family passwords have no equivalent runtime validation."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "session"
                ],
                "security-severity": "8.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-798",
                    "guid": "06db8e86-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html"
            },
            {
              "id": "DAST-CONFIG-003",
              "name": "Session Cookie Secure Flag Defaults to False",
              "shortDescription": {
                "text": "Session Cookie Secure Flag Defaults to False"
              },
              "fullDescription": {
                "text": "The SESSION_COOKIE_SECURE setting defaults to False. When False, the is_secure_request() function falls back to inspecting X-Forwarded-Proto, but if not behind a trusted proxy this header can be spoofed. On a non-TLS development or misconfigured production deployment, session cookies are transmitted over plain HTTP."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "cookie"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-614",
                    "guid": "2daefa1b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/614.html"
            },
            {
              "id": "DAST-CONFIG-004",
              "name": "In-Memory Rate Limiter Ineffective for Multi-Instance or Restarted Deployments",
              "shortDescription": {
                "text": "In-Memory Rate Limiter Ineffective for Multi-Instance or Restarted Deployments"
              },
              "fullDescription": {
                "text": "The RateLimiter in rate_limit.py uses a Python in-process defaultdict of deques. This state is lost on every restart and is not shared across multiple app replicas. An attacker can exhaust the lockout window by restarting the app, or bypass per-IP limits entirely when the app is scaled horizontally."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "rate-limiting"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-770",
                    "guid": "a3b75884-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/770.html"
            },
            {
              "id": "DAST-CONFIG-005",
              "name": "X-Forwarded-For Header Spoofing Enables Rate Limit Bypass",
              "shortDescription": {
                "text": "X-Forwarded-For Header Spoofing Enables Rate Limit Bypass"
              },
              "fullDescription": {
                "text": "get_request_ip() in security.py takes the FIRST element of the X-Forwarded-For header, which can be injected by any client. When nginx proxies through, it appends the real client IP but does not strip existing X-Forwarded-For headers from untrusted clients. An attacker can supply X-Forwarded-For: 1.1.1.1 and the rate limiter will key on that spoofed IP instead of the real one."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "rate-limiting"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-290",
                    "guid": "3bed438d-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/290.html"
            },
            {
              "id": "DAST-CONFIG-006",
              "name": "Weak TLS Cipher Suite in nginx-tls.conf",
              "shortDescription": {
                "text": "Weak TLS Cipher Suite in nginx-tls.conf"
              },
              "fullDescription": {
                "text": "The nginx TLS configuration uses ssl_ciphers HIGH:!aNULL:!MD5 which is the legacy OpenSSL HIGH keyword. This set includes 3DES (CBC mode, SWEET32 attack surface) and other cipher suites that are no longer recommended. It does not follow modern TLS hardening guidelines (Mozilla Intermediate or Modern profile)."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "tls"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-326",
                    "guid": "9b173b55-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/326.html"
            },
            {
              "id": "DAST-CONFIG-007",
              "name": "Password Policy Missing Special Character Requirement",
              "shortDescription": {
                "text": "Password Policy Missing Special Character Requirement"
              },
              "fullDescription": {
                "text": "validate_password_policy() in validation.py enforces minimum length (12) and requires at least one letter and one number, but does not require any special/symbol characters. Passwords like 'Password123456' satisfy the policy but are easily dictionary-attacked."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "password"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-521",
                    "guid": "6a92f43b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/521.html"
            },
            {
              "id": "DAST-CONFIG-008",
              "name": "OpenAPI Documentation Publicly Accessible Without Authentication",
              "shortDescription": {
                "text": "OpenAPI Documentation Publicly Accessible Without Authentication"
              },
              "fullDescription": {
                "text": "The OpenAPI schema (/api/openapi.json), Swagger UI (/api/docs), and ReDoc (/api/redoc) are included in PUBLIC_API_PATHS and require no authentication. The full API surface, endpoint paths, request/response schemas, and authentication mechanisms are all discoverable by unauthenticated users."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-200",
                    "guid": "88a4db48-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html"
            },
            {
              "id": "DAST-CONFIG-009",
              "name": "Pydantic Validation Errors Expose Schema Details in 422 Responses",
              "shortDescription": {
                "text": "Pydantic Validation Errors Expose Schema Details in 422 Responses"
              },
              "fullDescription": {
                "text": "The RequestValidationError handler in main.py returns exc.errors() directly in the response body. Pydantic validation errors include field paths, expected types, and constraint descriptions that reveal internal schema structure to API clients."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-209",
                    "guid": "5ff2ed62-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/209.html"
            },
            {
              "id": "DAST-CONFIG-010",
              "name": "Demo Mode Enabled by Default in .env.example",
              "shortDescription": {
                "text": "Demo Mode Enabled by Default in .env.example"
              },
              "fullDescription": {
                "text": "The .env.example template ships with DEMO_MODE=true. If deployed without customization, the app seeds demo data (families, students, assignments) on first boot. Demo users may have weak default passwords and the seeded data could interfere with or confuse production operation."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-1188",
                    "guid": "0e88a4e3-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/1188.html"
            },
            {
              "id": "DAST-CONFIG-011",
              "name": "SMTP TLS Disabled in Default Configuration",
              "shortDescription": {
                "text": "SMTP TLS Disabled in Default Configuration"
              },
              "fullDescription": {
                "text": "The .env.example template sets SMTP_USE_TLS=false and SMTP_PORT=1025, pointing to a development mailpit relay. Invitation emails, security alerts, and other notifications would be transmitted as cleartext if this configuration is used in production."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "tls"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-319",
                    "guid": "501ea8cc-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/319.html"
            },
            {
              "id": "DAST-CONFIG-012",
              "name": "Public Portfolio Endpoint Exposes Student PII Without Authentication",
              "shortDescription": {
                "text": "Public Portfolio Endpoint Exposes Student PII Without Authentication"
              },
              "fullDescription": {
                "text": "The GET /api/portfolio/public/{share_token} endpoint is unauthenticated and returns student_id, portfolio entry titles, dates, subject names, and assignment information. When a share link is activated, all this structured data is accessible to anyone with the URL."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-359",
                    "guid": "585dcd81-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/359.html"
            },
            {
              "id": "DAST-CONFIG-013",
              "name": "Backup Data Unencrypted by Default",
              "shortDescription": {
                "text": "Backup Data Unencrypted by Default"
              },
              "fullDescription": {
                "text": "The BACKUP_ENCRYPTION_KEY setting defaults to null/None. If no encryption key is configured, backup archives (containing the entire database and uploaded student files) are stored or transmitted without encryption."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-311",
                    "guid": "e1564903-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/311.html"
            },
            {
              "id": "DAST-CONFIG-014",
              "name": "Legacy Family Password Defaults to 'changeme'",
              "shortDescription": {
                "text": "Legacy Family Password Defaults to 'changeme'"
              },
              "fullDescription": {
                "text": "The FAMILY_PASSWORD setting defaults to 'changeme' in both config.py and .env.example. This legacy field, used for migration compatibility from older versions, uses a trivially guessable default password that operators may leave unchanged."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "password"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-798",
                    "guid": "06db8e86-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html"
            },
            {
              "id": "DAST-CONFIG-015",
              "name": "Bootstrap Owner Account Uses Predictable Default Email",
              "shortDescription": {
                "text": "Bootstrap Owner Account Uses Predictable Default Email"
              },
              "fullDescription": {
                "text": "The bootstrap initial admin account email defaults to 'owner@homeschool-hero.local'. If an operator doesn't customize this and the app is internet-exposed, an attacker can try to register or enumerate this known email address."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-798",
                    "guid": "06db8e86-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/798.html"
            },
            {
              "id": "DAST-CONFIG-016",
              "name": "nginx Reverse Proxy Has No Connection or Request Rate Limiting",
              "shortDescription": {
                "text": "nginx Reverse Proxy Has No Connection or Request Rate Limiting"
              },
              "fullDescription": {
                "text": "Both nginx.conf and nginx-tls.conf have no nginx-level rate limiting (limit_req_zone, limit_conn_zone directives). All traffic, including unauthenticated login attempts, flows directly to the FastAPI application. Application-level rate limiting can be exhausted by bulk traffic before it takes effect."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "rate-limiting"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-770",
                    "guid": "a3b75884-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/770.html"
            },
            {
              "id": "DAST-CONFIG-017",
              "name": "Capabilities Endpoint Discloses Deployment Configuration",
              "shortDescription": {
                "text": "Capabilities Endpoint Discloses Deployment Configuration"
              },
              "fullDescription": {
                "text": "The public /api/capabilities endpoint returns the state of all feature flags and service capabilities including AI provider status (Ollama, OpenAI), OIDC/SAML configuration state, backup status, and OCR availability. This information helps an attacker fingerprint the deployment."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-200",
                    "guid": "88a4db48-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html"
            },
            {
              "id": "DAST-CONFIG-018",
              "name": "JWT Symmetric Secret Has No Minimum Length Validation",
              "shortDescription": {
                "text": "JWT Symmetric Secret Has No Minimum Length Validation"
              },
              "fullDescription": {
                "text": "When JWT_ENABLED=true with a symmetric JWT_SECRET (HMAC), there is no startup validation enforcing a minimum secret length. A short or weak JWT_SECRET allows HMAC brute-force attacks against captured tokens. The symmetric path is common in integrations where a shared secret is used instead of JWKS."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "jwt"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-321",
                    "guid": "9c73da8b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/321.html"
            },
            {
              "id": "DAST-CONFIG-019",
              "name": "nginx TLS Configuration Missing HSTS Preload Directive",
              "shortDescription": {
                "text": "nginx TLS Configuration Missing HSTS Preload Directive"
              },
              "fullDescription": {
                "text": "The nginx-tls.conf Strict-Transport-Security header includes max-age and includeSubDomains but not the preload directive. Without preload, browsers will not include the domain in the HSTS preload list, leaving first-time visitors or cleared-cache users vulnerable to SSL stripping on first connection."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "tls"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-319",
                    "guid": "501ea8cc-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/319.html"
            },
            {
              "id": "DAST-CONFIG-020",
              "name": "OIDC Verify Endpoint Publicly Discloses Identity Provider Details",
              "shortDescription": {
                "text": "OIDC Verify Endpoint Publicly Discloses Identity Provider Details"
              },
              "fullDescription": {
                "text": "The public GET /api/auth/oidc/verify endpoint probes and returns OIDC configuration including the discovery URL, issuer, and authorization endpoint. This information aids attackers in understanding the identity provider setup and formulating OIDC-targeted attacks."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "info-disclosure"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-200",
                    "guid": "88a4db48-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/200.html"
            },
            {
              "id": "DAST-CONFIG-021",
              "name": "nginx client_max_body_size Exceeds Application Upload Limit",
              "shortDescription": {
                "text": "nginx client_max_body_size Exceeds Application Upload Limit"
              },
              "fullDescription": {
                "text": "nginx allows request bodies up to 50MB (client_max_body_size 50m) while the application enforces UPLOAD_MAX_BYTES of 25MB. Requests between 25MB-50MB will be fully received by nginx, transferred to the app, and then rejected by FastAPI after consuming server resources unnecessarily."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "api-auth"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-770",
                    "guid": "a3b75884-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/770.html"
            },
            {
              "id": "DAST-CONFIG-022",
              "name": "Invitation Accept Endpoint Missing Password Validation Against Full Policy",
              "shortDescription": {
                "text": "Invitation Accept Endpoint Missing Password Validation Against Full Policy"
              },
              "fullDescription": {
                "text": "The invitation acceptance endpoint (POST /api/invitations/{id}/accept) creates new user accounts with a password provided at acceptance time. However, the InvitationAccept schema does not enforce the same password policy (minimum length, character requirements) as RegisterRequest. New users invited via email can set weak passwords."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "password"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-521",
                    "guid": "6a92f43b-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/521.html"
            },
            {
              "id": "DAST-CONFIG-023",
              "name": "Session Cookie SameSite=lax Does Not Prevent All Cross-Site Request Scenarios",
              "shortDescription": {
                "text": "Session Cookie SameSite=lax Does Not Prevent All Cross-Site Request Scenarios"
              },
              "fullDescription": {
                "text": "Both the session cookie and CSRF cookie are set with samesite='lax'. While the application implements a CSRF double-submit cookie pattern for state-changing requests, SameSite=lax still allows cookies to be sent in top-level GET navigations and certain redirect flows. Combined with any future GET-based state-changing endpoint, this reduces defense in depth."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "cookie"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-1275",
                    "guid": "8b6fd0ee-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/1275.html"
            },
            {
              "id": "DAST-CONFIG-024",
              "name": "BCrypt Password Maximum Byte Limit Silently Truncates Long Passwords",
              "shortDescription": {
                "text": "BCrypt Password Maximum Byte Limit Silently Truncates Long Passwords"
              },
              "fullDescription": {
                "text": "BCrypt silently truncates passwords at 72 bytes. The validate_bcrypt_password_length() function correctly rejects passwords over 72 bytes (raising ValueError), but does not warn users that passwords close to 72 bytes may have characters ignored. Users who craft exactly 72-byte passwords have less security than they believe."
              },
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "tags": [
                  "password"
                ],
                "security-severity": "3.0"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-916",
                    "guid": "c0e49dc3-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/916.html"
            },
            {
              "id": "DAST-CONFIG-025",
              "name": "Dependency: python3-saml Uses XML Processing With Known Vulnerability History",
              "shortDescription": {
                "text": "Dependency: python3-saml Uses XML Processing With Known Vulnerability History"
              },
              "fullDescription": {
                "text": "python3-saml 1.16.0 is pinned in requirements.txt. The python3-saml library has historically been affected by XML signature wrapping (XSW) attacks and entity expansion (XXE) vulnerabilities. Version 1.16.0 is relatively recent but should be regularly audited against the python3-saml security advisory history."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "dependency"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-347",
                    "guid": "6e99ca2e-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/347.html"
            },
            {
              "id": "DAST-CONFIG-026",
              "name": "Dependency: pillow and PyMuPDF Process Untrusted Uploaded Files",
              "shortDescription": {
                "text": "Dependency: pillow and PyMuPDF Process Untrusted Uploaded Files"
              },
              "fullDescription": {
                "text": "pillow 12.2.0 (image processing) and PyMuPDF 1.27.2.3 (PDF processing) are used to process user-uploaded content. These libraries have historically contained memory safety vulnerabilities when parsing maliciously crafted files. Untrusted file processing without sandboxing creates risk of RCE or DoS."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "dependency"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
                  "target": {
                    "id": "CWE-20",
                    "guid": "c7bf7667-0000-0000-0000-000000000000",
                    "toolComponent": {
                      "name": "CWE",
                      "guid": "a0a0a0a0-0000-0000-0000-000000000000"
                    }
                  },
                  "kinds": [
                    "superset"
                  ]
                }
              ],
              "helpUri": "https://cwe.mitre.org/data/definitions/20.html"
            },
            {
              "id": "DAST-CONFIG-027",
              "name": "Upload MIME Type Validation Relies on Unverified Client-Provided Content-Type",
              "shortDescription": {
                "text": "Upload MIME Type Validation Relies on Unverified Client-Provided Content-Type"
              },
              "fullDescription": {
                "text": "The normalize_upload_type() function in storage.py determines the upload content type using the Content-Type field from the multipart form, which is set by the client. While the function validates that the type is in the allowed list, it does not verify file magic bytes to confirm the actual content type matches the declared type."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "api-auth"
                ],
                "security-severity": "5.5"
              },
              "relationships": [
                {
