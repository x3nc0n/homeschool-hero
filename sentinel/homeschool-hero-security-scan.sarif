              }
            }
          ]
        },
        {
          "ruleId": "DAST-CONFIG-023",
          "ruleIndex": 59,
          "level": "note",
          "message": {
            "text": "security.py lines 162-170: session cookie uses samesite='lax' not 'strict'. The CSRF double-submit pattern in require_csrf() is robust for POST/PUT/DELETE, but SameSite=strict would eliminate the need for CSRF protection entirely. The current design requires maintaining both mechanisms."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/security.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 162,
                  "endLine": 170,
                  "startColumn": 1,
                  "endColumn": 40,
                  "snippet": {
                    "text": "response.set_cookie(\n    key=settings.session_cookie_name,\n    value=token,\n    httponly=True,\n    samesite='lax',\n    secure=secure,\n    max_age=settings.session_max_age_seconds,\n    path='/',\n)"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "category": "cookie"
          },
          "fixes": [
            {
              "description": {
                "text": "Evaluate whether samesite='strict' can be used. If OIDC/SAML redirect flows require lax (because browser redirects need cookies), keep lax and document the reason. Ensure CSRF protection remains in place for all state-changing operations."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-1275",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
        {
          "ruleId": "DAST-CONFIG-024",
          "ruleIndex": 60,
          "level": "note",
          "message": {
            "text": "validation.py lines 46-49: BCRYPT_PASSWORD_MAX_BYTES = 72 and the validator rejects >72 bytes but does not warn at a lower threshold. A user with a 71-byte UTF-8 password may mistakenly believe all characters contribute to the hash. Best practice is to either use a pre-hash (SHA-256) before bcrypt or document the limitation at account creation."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "backend/validation.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 46,
                  "endLine": 49,
                  "startColumn": 1,
                  "endColumn": 60,
                  "snippet": {
                    "text": "def validate_bcrypt_password_length(password: str) -> str:\n    if len(password.encode('utf-8')) > BCRYPT_PASSWORD_MAX_BYTES:\n        raise ValueError(f'Password must be {BCRYPT_PASSWORD_MAX_BYTES} bytes or fewer')\n    return password"
                  }
                }
              }
            }
          ],
          "properties": {
            "severity": "low",
            "category": "password"
          },
          "fixes": [
            {
              "description": {
                "text": "Apply a SHA-256 pre-hash before bcrypt (e.g., bcrypt(sha256(password))) to support arbitrary-length passwords without the 72-byte limit, while preserving bcrypt's salting/cost benefits. Alternatively, document the 72-byte limit clearly in the UI and warn users when their password length approaches this limit."
              }
            }
          ],
          "taxa": [
            {
              "id": "CWE-916",
              "toolComponent": {
                "name": "CWE"
              }
            }
          ]
        },
