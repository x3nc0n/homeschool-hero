# Core app + database
APP_PORT=8000
POSTGRES_USER=homeschool
POSTGRES_PASSWORD=changeme
POSTGRES_DB=homeschool_hero
DATABASE_URL=postgresql+asyncpg://homeschool:changeme@db:5432/homeschool_hero

# Required security settings
SECRET_KEY=super-secret-change-me
SESSION_COOKIE_NAME=homeschool_session
CSRF_COOKIE_NAME=homeschool_csrf
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false
SESSION_ROTATION_SECONDS=1800
PASSWORD_MIN_LENGTH=12
AUTH_LOCKOUT_THRESHOLD=5
AUTH_LOCKOUT_MINUTES=15

# Optional auth provider settings
AUTH_PROVIDER=local
AUTH_AUTO_PROVISION_MODE=default_family
AUTH_DEFAULT_FAMILY_NAME=SSO Users
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISCOVERY_URL=
# SAML_METADATA_URL=
# SAML_ENTITY_ID=
# SAML_ACS_URL=

# Initial owner bootstrap
BOOTSTRAP_OWNER_EMAIL=owner@homeschool-hero.local
BOOTSTRAP_OWNER_DISPLAY_NAME=Family Owner
BOOTSTRAP_FAMILY_NAME=My Family
BOOTSTRAP_TIMEZONE=UTC
BOOTSTRAP_GRADING_SCALE=letter

# Legacy migration support (keep populated when upgrading older installs)
FAMILY_PASSWORD=changeme
FAMILY_PASSWORD_HASH=

# App runtime
CONFIDENCE_THRESHOLD=0.8
GRADING_POLL_INTERVAL=5
GRADING_REQUEST_TIMEOUT_SECONDS=120
OCR_REQUEST_TIMEOUT_SECONDS=120
GRADING_RETRY_ATTEMPTS=3
GRADING_RETRY_BACKOFF_SECONDS=1
AI_CIRCUIT_BREAKER_THRESHOLD=3
AI_CIRCUIT_BREAKER_RESET_SECONDS=300
ENABLE_METRICS_ENDPOINT=false
LOG_LEVEL=INFO
# LOG_JSON=true
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_BYTES=26214400
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png,image/heic,image/heif,image/tiff,image/webp
MIGRATION_MODE=apply
INVITATION_BASE_URL=http://localhost:8000

# Optional AI profile (docker compose --profile ai up)
AI_PROVIDER=ollama
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=llama3.2
OPENAI_API_KEY=

# Optional email profile defaults (docker compose --profile email up)
# For production, replace SMTP_HOST/PORT/credentials with your real relay.
SMTP_HOST=smtp
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notifications@homeschool-hero.local
SMTP_USE_TLS=false
SMTP_DEV_PORT=1025
SMTP_WEB_PORT=8025

# Optional backup profile defaults (docker compose --profile backup up)
BACKUP_TARGET=/data/backups
BACKUP_DESTINATION=local
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=14
BACKUP_FILENAME_PREFIX=homeschool-hero
BACKUP_SCHEDULER_ENABLED=true
# BACKUP_MOUNT_SOURCE=./data/backups
# BACKUP_SMB_HOST=nas.local
# BACKUP_SMB_SHARE=homeschool-hero
# BACKUP_SMB_USER=backup-user
# BACKUP_SMB_PASSWORD=change-me
# BACKUP_NFS_HOST=nas.local
# BACKUP_NFS_PATH=/exports/homeschool-hero
# BACKUP_ENCRYPTION_KEY=restic-password-or-long-random-secret

# Container memory limits
APP_MEMORY_LIMIT=1536m
DB_MEMORY_LIMIT=1024m
OLLAMA_MEMORY_LIMIT=6g
SMTP_MEMORY_LIMIT=256m
BACKUP_MEMORY_LIMIT=256m
